    "z": "pv_tab",
    "name": "ESP32 reto2026/+/data",
    "topic": "reto2026/+/data",
    "qos": "1",
    "datatype": "json",
    "broker": "pv_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 120,
    "wires": [
