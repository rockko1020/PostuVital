        "pv_prep",
        "pv_dash"
      ]
    ]
  },
  {
    "id": "pv_prep",
    "type": "function",
    "z": "pv_tab",
    "name": "Preparar para MySQL (API)",
    "func": "const d = msg.payload;\nif (typeof d !== \"object\" || d === null) return null;\nmsg.payload = {\n  clave: \"CAMBIA_ESTA_CLAVE\",\n  mac: d.mac,\n  bpm: d.hr,\n  spo2: d.spo2,\n  temp_c: d.temp_c,\n  acc_g: d.acc_g,\n  roll: d.roll,\n  pitch: d.pitch,\n  fall: d.fall ? 1 : 0,\n  inicio: !!d.inicio\n};\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 60,
    "wires": [
      [
        "pv_http"
      ]
    ]
  },
  {
    "id": "pv_http",
    "type": "http request",
    "z": "pv_tab",
    "name": "POST api.php (MySQL)",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost/postuvital/api.php",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 680,
    "y": 60,
    "wires": [
      [
        "pv_dbg"
      ]
    ]
  },
  {
    "id": "pv_dbg",
    "type": "debug",
    "z": "pv_tab",
    "name": "Respuesta MySQL",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 930,
    "y": 60,
    "wires": []
  },
  {
    "id": "pv_dash",
    "type": "function",
    "z": "pv_tab",
    "name": "Separar para dashboard",
    "func": "const d = msg.payload;\nif (typeof d !== \"object\" || d === null) return null;\nconst out = [null, null, null, null, null, null];\nif (d.spo2 !== undefined) out[0] = { payload: d.spo2 };\nif (d.hr !== undefined)   out[1] = { payload: d.hr };\nif (d.temp_c !== undefined) out[2] = { payload: d.temp_c };\nconst serie = [];\nif (d.hr !== undefined)   serie.push({ topic: \"Pulso (lpm)\", payload: d.hr });\nif (d.spo2 !== undefined) serie.push({ topic: \"SpO2 (%)\", payload: d.spo2 });\nif (serie.length) out[3] = serie;\nout[4] = { payload: d.fall ? \"CAIDA DETECTADA\" : (d.alarm ? \"Alarma: valores fuera de rango\" : \"Normal\") };\nout[5] = { payload: \"Aceleracion: \" + d.acc_g + \" g   |   Roll: \" + d.roll + \"   |   Pitch: \" + d.pitch };\nreturn out;",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 240,
    "wires": [
      [
        "pv_g_spo2"
      ],
      [
        "pv_g_hr"
      ],
      [
        "pv_g_temp"
      ],
      [
        "pv_chart"
      ],
      [
        "pv_t_estado"
      ],
      [
        "pv_t_mov"
      ]
    ]
  },
